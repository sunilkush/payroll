# Sab optional hain. Ek hi server se API + React chalane par (Render, ya SERVE_CLIENT=true) kuch nahi likhna.

# Backend alag domain par ho tabhi uska poora URL do (build ke waqt padha jata hai).
# Dev mein khali chhodo (Vite proxy use hota hai).
VITE_API_URL=

# ---- Sirf dev server (npm run dev:client) ----
# Vite ka port. Badlo to server/.env ka CLIENT_URL bhi badlo.
# VITE_DEV_PORT=5173
# Dev mein /api kis backend par jaye. server/.env ka PORT badla ho to yahan bhi badlo.
# VITE_DEV_API_TARGET=http://localhost:5000
