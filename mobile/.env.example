# Is file ko .env naam se copy karo. App build/start ke waqt padha jata hai (badalne par Expo dobara chalao).

# Backend ka URL (bina /api/v1 ke).
#   Android emulator -> http://10.0.2.2:5000
#   Asli phone (Expo Go) -> computer ka LAN IP, jaise http://192.168.1.10:5000
#   Production -> https://your-domain.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000

# (Optional) Web app ka URL, jaise https://your-domain.com. Password reset ki email ka link isi par banta hai;
# dene par wo link app mein khul sakta hai (domain par App Links / Universal Links bhi lagane honge).
# EXPO_PUBLIC_WEB_URL=

# (Optional) Map ke tiles ka URL. Khali ho to web app wale hi tiles.
# EXPO_PUBLIC_MAP_TILE_URL=
