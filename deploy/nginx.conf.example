# /etc/nginx/sites-available/payroll  (payroll.example.com ko apne domain se badlo)
#
# Nginx HTTPS sambhalta hai aur saari requests Node server (port 5000) ko deta hai.
# Node hi API aur React build dono serve karta hai (SERVE_CLIENT=true).
#
# Certificate (free, Let's Encrypt):
#   sudo certbot --nginx -d payroll.example.com
# certbot neeche ke ssl_certificate lines khud bhar deta hai aur auto-renew laga deta hai.

server {
    listen 80;
    server_name payroll.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name payroll.example.com;

    ssl_certificate     /etc/letsencrypt/live/payroll.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/payroll.example.com/privkey.pem;

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Inhi headers se Node ko asli client IP aur HTTPS ka pata chalta hai (server/.env: TRUST_PROXY=1)
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
