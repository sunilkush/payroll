# development | production
NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/payroll

# Lamba random string rakho: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production mein 32 characters se chhota ho to server start nahi hota.
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
# Mobile app ka refresh token kitne din chale (har refresh par ginti phir shuru)
# REFRESH_TOKEN_DAYS=30

# ---- Free trial / subscription ----
# Neeche ke TRIAL_DAYS, PLAN_STAFF_LIMIT_*, PLAN_PRICE_*, BILLING_MONTHS aur GST_PERCENT sirf PEHLI BAAR ke defaults hain.
# Server chalne ke baad ye sab Super Admin panel (Global Settings > Packages / Billing rules) se badalte hain,
# aur wahan ki value hi chalti hai.
# Khud register karne wali company ka free trial (din)
# TRIAL_DAYS=30
# Khatam hone se kitne din pehle admin ko email + push jaye
# SUBSCRIPTION_REMINDER_DAYS=15,7,1
# Plan mein kitne active staff ho sakte hain ('unlimited' = koi hadd nahi)
# PLAN_STAFF_LIMIT_FREE=10
# PLAN_STAFF_LIMIT_STARTER=50
# PLAN_STAFF_LIMIT_PROFESSIONAL=250
# PLAN_STAFF_LIMIT_ENTERPRISE=unlimited
# Plan ka daam: rupaye / mahina, GST alag. 'custom' = tay daam nahi (online nahi bikta, sales se baat).
# PLAN_PRICE_STARTER=999
# PLAN_PRICE_PROFESSIONAL=2499
# PLAN_PRICE_ENTERPRISE=custom
# Payment ek saath itne mahino ki hoti hai (daam mahine ka dikhta hai), aur us par GST %
# BILLING_MONTHS=12
# GST_PERCENT=18

# ---- Razorpay (online payment) ----
# Razorpay Dashboard > Account & Settings > API Keys. Khali ho to online payment band rehta hai aur
# purana tareeka chalta hai (admin request bhejta hai, Super Admin manzoor karta hai).
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks: URL https://your-domain.com/api/v1/webhooks/razorpay, events: payment.captured, payment.failed.
# Wahan jo secret likho wahi yahan.
# RAZORPAY_WEBHOOK_SECRET=

# ---- GST invoice (bechne wale ki jaankari, invoice par chhapti hai) ----
# GST_SELLER_NAME=Your Company Pvt Ltd
# GST_SELLER_ADDRESS=Office address, City, PIN
# GST_SELLER_GSTIN=
# Aapka state (jaise Haryana). Kharidne wala isi state ka ho to CGST + SGST, warna IGST.
# GST_SELLER_STATE=
# Service ka SAC code (apne CA se confirm karo)
# GST_SAC=998314
# Invoice number ka shuruaati hissa: PR/2026-27/0001
# INVOICE_PREFIX=PR

# ---- Mobile app ----
# Is se purana app khulta nahi ("Update required" screen). Khali = koi rok nahi.
# MOBILE_MIN_VERSION=1.0.0
# MOBILE_LATEST_VERSION=1.0.0
# Us screen ke Update button ke store links
# MOBILE_ANDROID_URL=https://play.google.com/store/apps/details?id=com.payroster.app
# MOBILE_IOS_URL=

# Sales meeting ke QR token ka secret (optional). Khali ho to JWT_SECRET se nikalta hai;
# alag rakhne se JWT_SECRET badalne par bheje hue QR chalte rehte hain.
# QR_SECRET=

# Upload hui files (visit photo, attachments) ka folder. Khali ho to server/uploads.
# UPLOAD_DIR=

BCRYPT_ROUNDS=10

# Attendance ki "aaj ki date" aur cron jobs isi timezone mein chalte hain
APP_TIMEZONE=Asia/Kolkata

# Frontend origin (CORS + email ke links). Comma se kai de sakte ho; pehla wala asli maana jata hai.
# Production mein apna domain: https://payroll.example.com
# Render par likhna zaroori nahi: Render ke RENDER_EXTERNAL_URL se apne aap ban jata hai.
CLIENT_URL=http://localhost:5173

# ---- Deployment ----
# Server ke aage kitne reverse proxy hain. Nginx ke peeche: 1. Seedha chala rahe ho: 0
# (Render par apne aap 1.)
TRUST_PROXY=0
# HTTP ko HTTPS par bhejo. Na likho to production mein true, development mein false.
# FORCE_HTTPS=true
# client/dist isi server se serve karo. Na likho to production mein true, development mein false.
# SERVE_CLIENT=true

# Login brute-force protection
LOGIN_RATE_LIMIT_WINDOW_MIN=15
LOGIN_RATE_LIMIT_MAX=20

# Website se free account banana (company + admin). Band karna ho to false.
# ALLOW_REGISTRATION=true
# Ek IP se ek ghante mein kitne naye accounts
REGISTER_RATE_LIMIT_MAX=5

# ---- Email (verification code aur password reset) ----
# SMTP_HOST khali ho to email nahi jati: tab naye account se email verify nahi karwayi jati, aur
# development mein code / reset link server ke console par chhap jata hai.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=PayRoster <no-reply@your-domain.com>

# npm run seed:superadmin ke liye
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=change-me

# Tests alag database par chalte hain (naam "_test" par khatam hona zaroori hai)
# TEST_MONGO_URI=mongodb://127.0.0.1:27017/payroll_test
