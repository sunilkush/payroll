# development | production
NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/payroll

# Lamba random string rakho: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production mein 32 characters se chhota ho to server start nahi hota.
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Sales meeting ke QR token ka secret (optional). Khali ho to JWT_SECRET se nikalta hai;
# alag rakhne se JWT_SECRET badalne par bheje hue QR chalte rehte hain.
# QR_SECRET=

# Upload hui files (visit photo, attachments) ka folder. Khali ho to server/uploads.
# UPLOAD_DIR=

BCRYPT_ROUNDS=10

# Attendance ki "aaj ki date" aur cron jobs isi timezone mein chalte hain
APP_TIMEZONE=Asia/Kolkata

# Frontend origin (CORS). Production mein apna domain: https://payroll.example.com
CLIENT_URL=http://localhost:5173

# ---- Deployment ----
# Server ke aage kitne reverse proxy hain. Nginx ke peeche: 1. Seedha chala rahe ho: 0
TRUST_PROXY=0
# HTTP ko HTTPS par bhejo. Na likho to production mein true, development mein false.
# FORCE_HTTPS=true
# client/dist isi server se serve karo. Na likho to production mein true, development mein false.
# SERVE_CLIENT=true

# Login brute-force protection
LOGIN_RATE_LIMIT_WINDOW_MIN=15
LOGIN_RATE_LIMIT_MAX=20

# Website se free account banana (company + admin). Band karna ho to false.
# ALLOW_REGISTRATION=true
# Ek IP se ek ghante mein kitne naye accounts
REGISTER_RATE_LIMIT_MAX=5

# ---- Email (verification code aur password reset) ----
# SMTP_HOST khali ho to email nahi jati: tab naye account se email verify nahi karwayi jati, aur
# development mein code / reset link server ke console par chhap jata hai.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=PayRoster <no-reply@your-domain.com>

# npm run seed:superadmin ke liye
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=change-me

# Tests alag database par chalte hain (naam "_test" par khatam hona zaroori hai)
# TEST_MONGO_URI=mongodb://127.0.0.1:27017/payroll_test
